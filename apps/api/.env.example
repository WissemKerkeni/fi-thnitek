NODE_ENV=development
PORT=3000
# Local compose database (dev-only credentials).
DATABASE_URL=postgres://app:app@localhost:5432/fi_thnitek
DATABASE_POOL_MAX=10
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (the admin web app).
CORS_ORIGINS=http://localhost:5173
APP_VERSION=0.0.0

# --- Auth (Phase 2) ---
# HMAC key for access tokens. This placeholder is refused when NODE_ENV=production.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Google OAuth *Web* client ID(s), comma-separated (Android and admin both send ID tokens for it).
GOOGLE_CLIENT_IDS=
# Google accounts admitted to the admin web app, comma-separated.
ADMIN_EMAILS=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=60
TERMS_VERSION=draft-2026-10

# --- Driver verification (Phase 3) ---
# Garage dev store (docker compose up -d garage && sh infrastructure/garage/init-dev.sh). Dev-only keys.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=fi-documents
S3_ACCESS_KEY_ID=GK1f2e3d4c5b6a79880f1e2d3c
S3_SECRET_ACCESS_KEY=6d1c4f0a9b8e7d6c5b4a39281706f5e4d3c2b1a0f9e8d7c6b5a4938271605f4e
MAX_UPLOAD_MB=8
# CIN protection: development placeholders, refused when NODE_ENV=production.
CIN_ENCRYPTION_KEY=ZGV2LW9ubHktY2luLWtleS0zMi1ieXRlcy1sb25nISE=
CIN_HMAC_KEY=dev-only-cin-hmac-key-change-me-0123456789
# Firebase service-account JSON for FCM pushes (keep it outside git). Unset = pushes are only logged.
FIREBASE_SERVICE_ACCOUNT_FILE=
